<view class="my-page safe-page data-v-52d90e3d"><block wx:if="{{!isLoggedIn}}"><view class="guest-card data-v-52d90e3d"><text class="guest-title data-v-52d90e3d">你还没有登录</text><text class="guest-copy data-v-52d90e3d">登录后可查看个人资料与管理登录状态。</text><u-button vue-id="704e9d00-1" type="primary" shape="circle" data-event-opts="{{[['^click',[['goLogin']]]]}}" bind:click="__e" class="data-v-52d90e3d" bind:__l="__l" vue-slots="{{['default']}}">去登录</u-button></view></block><block wx:else><view class="profile-card data-v-52d90e3d"><view class="profile-header data-v-52d90e3d"><view class="avatar data-v-52d90e3d">{{avatarText}}</view><view class="profile-main data-v-52d90e3d"><view class="username data-v-52d90e3d">{{userInfo.username||'未设置用户名'}}</view><view class="profile-bio data-v-52d90e3d">{{userInfo.bio||'这个人很低调，还没有填写简介。'}}</view><block wx:if="{{refreshing}}"><view class="refreshing data-v-52d90e3d">正在同步最新资料…</view></block></view></view><view class="email data-v-52d90e3d">{{userInfo.email||'未填写邮箱'}}</view></view><view class="stats-card data-v-52d90e3d"><view data-event-opts="{{[['tap',[['openRelation',['following']]]]]}}" class="stat-item data-v-52d90e3d" bindtap="__e"><text class="stat-value data-v-52d90e3d">{{relationStatsLoading?'…':stats.followingCount}}</text><text class="stat-label data-v-52d90e3d">我的关注</text></view><view class="stat-divider data-v-52d90e3d"></view><view data-event-opts="{{[['tap',[['openRelation',['followers']]]]]}}" class="stat-item data-v-52d90e3d" bindtap="__e"><text class="stat-value data-v-52d90e3d">{{relationStatsLoading?'…':stats.followersCount}}</text><text class="stat-label data-v-52d90e3d">我的粉丝</text></view></view><block wx:if="{{relationStatsError}}"><view data-event-opts="{{[['tap',[['retryRelationStats',['$event']]]]]}}" class="stats-error data-v-52d90e3d" bindtap="__e">{{''+relationStatsError+'，点击重试'}}</view></block><view class="menu-card data-v-52d90e3d"><view data-event-opts="{{[['tap',[['openArticleList',['mine']]]]]}}" class="menu-item data-v-52d90e3d" bindtap="__e"><view class="data-v-52d90e3d"><view class="menu-title data-v-52d90e3d">我的文章</view><view class="menu-copy data-v-52d90e3d">{{"共 "+(relationStatsLoading?'…':stats.articlesCount)+" 篇"}}</view></view><text class="menu-arrow data-v-52d90e3d">›</text></view><view data-event-opts="{{[['tap',[['openArticleList',['favorites']]]]]}}" class="menu-item menu-item--last data-v-52d90e3d" bindtap="__e"><view class="data-v-52d90e3d"><view class="menu-title data-v-52d90e3d">收藏的文章</view><view class="menu-copy data-v-52d90e3d">{{"共 "+(relationStatsLoading?'…':stats.favoritesCount)+" 篇"}}</view></view><text class="menu-arrow data-v-52d90e3d">›</text></view></view><view class="logout-button data-v-52d90e3d"><u-button vue-id="704e9d00-2" type="warning" plain="{{true}}" shape="circle" data-event-opts="{{[['^click',[['handleLogout']]]]}}" bind:click="__e" class="data-v-52d90e3d" bind:__l="__l" vue-slots="{{['default']}}">退出登录</u-button></view></block></view>