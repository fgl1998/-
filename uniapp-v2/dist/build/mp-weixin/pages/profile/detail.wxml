<view class="profile-page safe-page data-v-6348c2fd"><block wx:if="{{loading}}"><view class="state-card data-v-6348c2fd">正在加载作者资料…</view></block><block wx:else><block wx:if="{{errorMessage}}"><view class="state-card data-v-6348c2fd"><text class="state-title data-v-6348c2fd">作者主页加载失败</text><text class="state-copy data-v-6348c2fd">{{errorMessage}}</text><u-button vue-id="4831ba56-1" type="primary" plain="{{true}}" shape="circle" data-event-opts="{{[['^click',[['loadProfile']]]]}}" bind:click="__e" class="data-v-6348c2fd" bind:__l="__l" vue-slots="{{['default']}}">重新加载</u-button></view></block><block wx:else><block wx:if="{{profile}}"><view class="profile-card data-v-6348c2fd"><view class="avatar avatar--large data-v-6348c2fd">{{avatarText}}</view><view class="username data-v-6348c2fd">{{profile.username}}</view><view class="bio data-v-6348c2fd">{{profile.bio||'这个人还没有填写简介。'}}</view><view class="stats data-v-6348c2fd"><view class="stat stat--clickable data-v-6348c2fd" hover-class="stat--active" data-event-opts="{{[['tap',[['openRelation',['following']]]]]}}" bindtap="__e"><text class="stat-value data-v-6348c2fd">{{followingCount}}</text><text class="data-v-6348c2fd">关注</text></view><view class="stat stat--clickable data-v-6348c2fd" hover-class="stat--active" data-event-opts="{{[['tap',[['openRelation',['followers']]]]]}}" bindtap="__e"><text class="stat-value data-v-6348c2fd">{{followersCount}}</text><text class="data-v-6348c2fd">粉丝</text></view><view class="stat stat--clickable data-v-6348c2fd" hover-class="stat--active" data-event-opts="{{[['tap',[['openArticles',['$event']]]]]}}" bindtap="__e"><text class="stat-value data-v-6348c2fd">{{articleCount}}</text><text class="data-v-6348c2fd">文章</text></view></view><block wx:if="{{!isSelf}}"><u-button vue-id="4831ba56-2" type="primary" plain="{{profile.following}}" shape="circle" loading="{{followSubmitting}}" disabled="{{followSubmitting}}" data-event-opts="{{[['^click',[['toggleFollow']]]]}}" bind:click="__e" class="data-v-6348c2fd" bind:__l="__l" vue-slots="{{['default']}}">{{''+(profile.following?'已关注':'关注')+''}}</u-button></block><block wx:else><view class="self-label data-v-6348c2fd">这是我自己</view></block></view></block></block></block></view>