<view class="my-page safe-page data-v-439a83db"><block wx:if="{{!isLoggedIn}}"><view class="guest-card data-v-439a83db"><text class="guest-title data-v-439a83db">你还没有登录</text><text class="guest-copy data-v-439a83db">登录后可查看个人资料与管理登录状态。</text><u-button vue-id="704e9d00-1" type="primary" shape="circle" data-event-opts="{{[['^click',[['goLogin']]]]}}" bind:click="__e" class="data-v-439a83db" bind:__l="__l" vue-slots="{{['default']}}">去登录</u-button></view></block><block wx:else><view class="profile-card data-v-439a83db"><view class="profile-header data-v-439a83db"><view class="avatar data-v-439a83db">{{avatarText}}</view><view class="profile-main data-v-439a83db"><view class="username data-v-439a83db">{{userInfo.username||'未设置用户名'}}</view><view class="profile-bio data-v-439a83db">{{userInfo.bio||'这个人很低调，还没有填写简介。'}}</view><block wx:if="{{refreshing}}"><view class="refreshing data-v-439a83db">正在同步最新资料…</view></block></view></view><view class="email data-v-439a83db">{{userInfo.email||'未填写邮箱'}}</view></view><view class="stats-card data-v-439a83db"><view data-event-opts="{{[['tap',[['openRelation',['following']]]]]}}" class="stat-item data-v-439a83db" bindtap="__e"><text class="stat-value data-v-439a83db">{{relationStatsLoading?'…':stats.followingCount}}</text><text class="stat-label data-v-439a83db">我的关注</text></view><view class="stat-divider data-v-439a83db"></view><view data-event-opts="{{[['tap',[['openRelation',['followers']]]]]}}" class="stat-item data-v-439a83db" bindtap="__e"><text class="stat-value data-v-439a83db">{{relationStatsLoading?'…':stats.followersCount}}</text><text class="stat-label data-v-439a83db">我的粉丝</text></view></view><block wx:if="{{relationStatsError}}"><view data-event-opts="{{[['tap',[['retryRelationStats',['$event']]]]]}}" class="stats-error data-v-439a83db" bindtap="__e">{{''+relationStatsError+'，点击重试'}}</view></block><view class="menu-card data-v-439a83db"><view data-event-opts="{{[['tap',[['openArticleList',['mine']]]]]}}" class="menu-item data-v-439a83db" bindtap="__e"><view class="data-v-439a83db"><view class="menu-title data-v-439a83db">我的文章</view><view class="menu-copy data-v-439a83db">{{"共 "+stats.articlesCount+" 篇"}}</view></view><text class="menu-arrow data-v-439a83db">›</text></view><view data-event-opts="{{[['tap',[['openArticleList',['favorites']]]]]}}" class="menu-item menu-item--last data-v-439a83db" bindtap="__e"><view class="data-v-439a83db"><view class="menu-title data-v-439a83db">收藏的文章</view><view class="menu-copy data-v-439a83db">{{"共 "+stats.favoritesCount+" 篇"}}</view></view><text class="menu-arrow data-v-439a83db">›</text></view></view><view class="mock-tip data-v-439a83db">关注和粉丝已使用真实接口；文章与收藏暂为演示数据。</view><view class="logout-button data-v-439a83db"><u-button vue-id="704e9d00-2" type="warning" plain="{{true}}" shape="circle" data-event-opts="{{[['^click',[['handleLogout']]]]}}" bind:click="__e" class="data-v-439a83db" bind:__l="__l" vue-slots="{{['default']}}">退出登录</u-button></view></block></view>