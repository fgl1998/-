<view class="profile-page safe-page data-v-b7f1a176"><block wx:if="{{loading}}"><view class="state-card data-v-b7f1a176">正在加载作者资料…</view></block><block wx:else><block wx:if="{{errorMessage}}"><view class="state-card data-v-b7f1a176"><text class="state-title data-v-b7f1a176">作者主页加载失败</text><text class="state-copy data-v-b7f1a176">{{errorMessage}}</text><u-button vue-id="4831ba56-1" type="primary" plain="{{true}}" shape="circle" data-event-opts="{{[['^click',[['loadProfile']]]]}}" bind:click="__e" class="data-v-b7f1a176" bind:__l="__l" vue-slots="{{['default']}}">重新加载</u-button></view></block><block wx:else><block wx:if="{{profile}}"><view class="profile-card data-v-b7f1a176"><view class="avatar avatar--large data-v-b7f1a176">{{avatarText}}</view><view class="username data-v-b7f1a176">{{profile.username}}</view><view class="bio data-v-b7f1a176">{{profile.bio||'这个人还没有填写简介。'}}</view><view class="stats data-v-b7f1a176"><view class="stat data-v-b7f1a176"><text class="stat-value data-v-b7f1a176">{{followingCount}}</text><text class="data-v-b7f1a176">关注</text></view><view class="stat data-v-b7f1a176"><text class="stat-value data-v-b7f1a176">{{followersCount}}</text><text class="data-v-b7f1a176">粉丝</text></view><view class="stat data-v-b7f1a176"><text class="stat-value data-v-b7f1a176">{{articleCount}}</text><text class="data-v-b7f1a176">文章</text></view></view><block wx:if="{{!isSelf}}"><u-button vue-id="4831ba56-2" type="primary" plain="{{profile.following}}" shape="circle" loading="{{followSubmitting}}" disabled="{{followSubmitting}}" data-event-opts="{{[['^click',[['toggleFollow']]]]}}" bind:click="__e" class="data-v-b7f1a176" bind:__l="__l" vue-slots="{{['default']}}">{{''+(profile.following?'已关注':'关注')+''}}</u-button></block><block wx:else><view class="self-label data-v-b7f1a176">这是我自己</view></block></view></block></block></block></view>