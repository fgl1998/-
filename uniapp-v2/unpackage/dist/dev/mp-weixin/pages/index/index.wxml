<view class="page safe-page data-v-57280228"><block wx:if="{{!isLoggedIn}}"><view class="state-card state-card--guest data-v-57280228"><text class="state-title data-v-57280228">登录后查看文章</text><text class="state-copy data-v-57280228">发现社区里的最新内容、收藏文章并参与评论。</text><u-button vue-id="8dd740cc-1" type="primary" shape="circle" data-event-opts="{{[['^click',[['goLogin']]]]}}" bind:click="__e" class="data-v-57280228" bind:__l="__l" vue-slots="{{['default']}}">去登录</u-button></view></block><block wx:else><view class="page-toolbar data-v-57280228"><view class="data-v-57280228"><view class="toolbar-title data-v-57280228">社区文章</view><view class="toolbar-copy data-v-57280228">分享你的想法和经验</view></view><u-button vue-id="8dd740cc-2" type="primary" size="small" shape="circle" data-event-opts="{{[['^click',[['goCreate']]]]}}" bind:click="__e" class="data-v-57280228" bind:__l="__l" vue-slots="{{['default']}}">发布文章</u-button></view><block wx:if="{{$root.g0}}"><view class="state-card data-v-57280228"><text class="state-copy data-v-57280228">正在加载文章…</text></view></block><block wx:else><block wx:if="{{$root.g1}}"><view class="state-card data-v-57280228"><text class="state-title data-v-57280228">文章加载失败</text><text class="state-copy data-v-57280228">{{errorMessage}}</text><u-button vue-id="8dd740cc-3" type="primary" plain="{{true}}" shape="circle" data-event-opts="{{[['^click',[['retryLoad']]]]}}" bind:click="__e" class="data-v-57280228" bind:__l="__l" vue-slots="{{['default']}}">重新加载</u-button></view></block><block wx:else><block wx:if="{{$root.g2===0}}"><view class="state-card data-v-57280228"><text class="state-title data-v-57280228">还没有文章</text><text class="state-copy data-v-57280228">稍后再来看看吧。</text></view></block><block wx:else><block wx:for="{{$root.l0}}" wx:for-item="article" wx:for-index="__i0__" wx:key="slug"><view data-event-opts="{{[['tap',[['openArticle',['$0'],[[['articles','slug',article.$orig.slug]]]]]]]}}" class="article-card data-v-57280228" bindtap="__e"><view class="article-author data-v-57280228"><view data-event-opts="{{[['tap',[['openAuthor',['$0'],[[['articles','slug',article.$orig.slug,'author']]]]]]]}}" class="author-avatar data-v-57280228" catchtap="__e">{{''+article.m0+''}}</view><view class="author-info data-v-57280228"><view class="author-name data-v-57280228">{{article.$orig.author.username||'匿名作者'}}</view><view class="author-date data-v-57280228">{{article.m1}}</view></view></view><view class="article-title data-v-57280228">{{article.$orig.title||'未命名文章'}}</view><view class="article-summary data-v-57280228">{{article.$orig.description||'暂无摘要'}}</view><block wx:if="{{article.g3}}"><view class="tag-list data-v-57280228"><block wx:for="{{article.$orig.tags}}" wx:for-item="tag" wx:for-index="__i1__" wx:key="*this"><text class="tag data-v-57280228">{{"# "+tag}}</text></block></view></block><view class="favorite-count data-v-57280228">{{"♥ "+article.$orig.favoritesCount}}</view></view></block><view class="list-footer data-v-57280228"><block wx:if="{{loading}}"><text class="data-v-57280228">正在加载更多…</text></block><block wx:else><block wx:if="{{errorMessage}}"><text data-event-opts="{{[['tap',[['retryLoad',['$event']]]]]}}" class="footer-error data-v-57280228" bindtap="__e">{{''+errorMessage+'，点击重试'}}</text></block><block wx:else><block wx:if="{{!hasMore}}"><text class="data-v-57280228">没有更多了</text></block><block wx:else><text class="data-v-57280228">上拉加载更多</text></block></block></block></view></block></block></block></block></view>